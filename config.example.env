# 复制到 ~/.config/wvbar/secrets.env，然后填入自己的值
# 注意：微信 SQLCipher 加密 key 配置在 Alpha 里，不需要填在这里；
#      本项目只通过 Alpha 的本地 HTTP API 读取已解密的数据。

# Alpha 本地 API 地址（默认 5031）
ALPHA_BASE=http://127.0.0.1:5031

# Alpha 设置页里的 API Token
ALPHA_TOKEN=replace_with_your_alpha_token

# DeepSeek API Key
DEEPSEEK_API_KEY=replace_with_your_deepseek_key

# 可选：ASR 模型目录（Qwen3-ASR 0.6B ONNX）
# WV_ASR_MODEL_DIR=/path/to/qwen3-asr-0.6b

# 可选：运行模式
# WV_REALTIME_PROFILE=eco
